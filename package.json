{
  "name": "watchpile-server",
  "version": "0.1.0",
  "description": "Tracker de mídia self-hosted — API e wrapper Electron",
  "author": "Digit4w",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-demo.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts && biome format --write openapi.json",
    "electron:rebuild": "electron-rebuild -f -w better-sqlite3",
    "electron:dev": "cross-env NODE_OPTIONS=--import=tsx/esm electron electron/main.ts",
    "electron:typecheck": "tsc --noEmit -p tsconfig.electron.json",
    "electron:build": "bun run --cwd ../client build && tsc -p tsconfig.electron.build.json && node scripts/prepare-electron-dist.mjs && electron-builder --config electron-builder.config.mjs --publish never"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.1",
    "@scalar/hono-api-reference": "^0.11.16",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.3",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "lefthook": "^2.1.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
